# =============================================================================
# DataGuardian AI — single environment file
# =============================================================================
#
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (Windows)
#
# ONE file configures everything. All three consumers read this same file:
#
#   Backend      pydantic-settings loads it via an absolute path, so it works
#                no matter which directory uvicorn is started from.
#   Frontend     Vite's `envDir` points here. Only VITE_-prefixed variables
#                are ever inlined into the browser bundle — everything else
#                below stays server-side.
#   Compose      docker-compose.yml reads the repo-root .env by default.
#
# `.env` is gitignored. Never commit it. This template is committed and must
# contain no real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PROJECT_NAME=DataGuardian AI
VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

# JSON array. Must include every browser origin that calls this API.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Host is `localhost` when running the backend directly, `db` under Compose.
DATABASE_URL=postgresql+psycopg2://dataguardian:dataguardian@localhost:5432/dataguardian
DB_ECHO=false

# Consumed by docker-compose.yml when it starts PostgreSQL.
POSTGRES_USER=dataguardian
POSTGRES_PASSWORD=dataguardian
POSTGRES_DB=dataguardian


# -----------------------------------------------------------------------------
# Scheduler
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=false
SCAN_INTERVAL_MINUTES=60


# -----------------------------------------------------------------------------
# DataHub
# -----------------------------------------------------------------------------
# GMS base URL. Through the DataHub frontend proxy it is
# http://localhost:9002/api/gms instead.
DATAHUB_GMS_URL=http://localhost:8080

# Personal access token from the DataHub UI (Settings -> Access Tokens).
# Optional against a local quickstart with metadata-service auth disabled;
# required for any secured instance.
DATAHUB_TOKEN=

DATAHUB_GRAPHQL_PATH=/api/graphql
DATAHUB_TIMEOUT_SECONDS=30
# Transient failures only (connect refused, timeout, 429/502/503/504).
DATAHUB_MAX_RETRIES=2
DATAHUB_DEFAULT_PAGE_SIZE=20
DATAHUB_MAX_PAGE_SIZE=200
DATAHUB_VERIFY_SSL=true

# Metadata cache. Short TTL — DataHub changes on an ingestion cadence.
DATAHUB_CACHE_ENABLED=true
DATAHUB_CACHE_TTL_SECONDS=60
DATAHUB_CACHE_MAX_ENTRIES=512


# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
# Implemented: groq, grok. Placeholders: gemini, openai, claude — selecting
# one raises a clear "not implemented" error rather than failing obscurely.
LLM_PROVIDER=groq
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
# Low by design: governance explanations must be grounded, not creative.
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2

# !! Groq and Grok are DIFFERENT companies with nearly identical names. !!
# Their keys are not interchangeable:
#   Groq       inference host (Llama, Mixtral)   keys start `gsk_`
#   xAI/Grok   xAI's own model                   keys start `xai-`

# --- Groq (default) ----------------------------------------------------------
# Create a key at https://console.groq.com/keys
# SECRET — leave blank here; fill it in .env only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- xAI / Grok --------------------------------------------------------------
# Only needed when LLM_PROVIDER=grok. Create a key at https://console.x.ai
# Without a key for the selected provider the app still boots; LLM calls fail
# with a configuration error and /api/v1/health/llm reports configured=false.
XAI_API_KEY=
XAI_MODEL=grok-4-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# --- Gemini (placeholder provider) -------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# ONLY these VITE_ variables reach the browser. Never prefix a secret with
# VITE_ — doing so inlines it into the public JavaScript bundle.

# Backend origin the Vite dev server proxies /api to.
VITE_BACKEND_URL=http://localhost:8000

# Absolute API base URL for deployed environments. Leave unset in development
# so the dev proxy is used instead.
# VITE_API_BASE_URL=https://api.example.com/api
