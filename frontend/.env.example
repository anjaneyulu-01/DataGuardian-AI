# Copy to `.env.local` and adjust. Only `VITE_`-prefixed vars reach the browser,
# so never put secrets in this file.

# Backend origin the Vite dev server proxies `/api` to.
VITE_BACKEND_URL=http://localhost:8000

# Absolute API base URL. Leave unset in development so the dev proxy is used.
# VITE_API_BASE_URL=https://api.example.com/api
