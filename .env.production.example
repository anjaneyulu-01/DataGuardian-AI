# =============================================================================
# DataGuardian AI — production environment reference
# =============================================================================
#
# This file documents what to set in the RENDER DASHBOARD. Do not deploy it.
#
# Unlike local development — where one root `.env` feeds everything — Render
# scopes environment variables per service, so the variables below are split
# accordingly. `render.yaml` already declares the non-secret ones; you supply
# the rest at deploy time.
#
# Secrets must NEVER be committed. Everything marked SECRET is declared
# `sync: false` in render.yaml so Render prompts for it instead.
#
# Full walkthrough: docs/deployment.md
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND — Render Web Service "dataguardian-api"
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_ENV=production
# Do NOT set DEBUG. It derives from APP_ENV, so production cannot ship
# DEBUG-level logging just because someone forgot to turn it off.
# PORT is injected by Render — never hardcode it.

# --- CORS (the #1 cause of a "working" deploy that fails in the browser) ------
# Must exactly match the frontend origin: scheme + host, NO trailing slash.
# Accepts a JSON array or a comma-separated list.
# The backend logs a loud error at startup if this is still localhost-only
# while APP_ENV=production.
CORS_ORIGINS=https://dataguardian-web.onrender.com

# --- LLM ----------------------------------------------------------------------
# `auto` selects the first provider that has a key. Adding a second key gives
# automatic fail-over with no code change.
LLM_PROVIDER=auto
LLM_FALLBACK_ENABLED=true
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# At least one key is required for AI features. Without any, the API still
# boots and /api/v1/health/llm reports configured=false.
# SECRET — set in the Render dashboard only.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: pin a single vendor instead of `auto`.
# LLM_PROVIDER=grok
# XAI_API_KEY=
# XAI_MODEL=grok-4-fast-reasoning

# --- DataHub -------------------------------------------------------------------
# MUST be reachable from Render's network. A DataHub running on your laptop is
# NOT — see "DataHub is not publicly reachable" in docs/deployment.md for the
# three options (managed Acryl, tunnel, or ship without it).
#
# Left blank, the API runs fine, reports DataHub unreachable, and the frontend
# falls back to Demo Mode with a visible banner. That is a legitimate way to
# demo the product.
DATAHUB_GMS_URL=
# SECRET — required for any secured DataHub instance.
DATAHUB_TOKEN=

DATAHUB_TIMEOUT_SECONDS=30
DATAHUB_MAX_RETRIES=2
DATAHUB_CACHE_ENABLED=true
DATAHUB_CACHE_TTL_SECONDS=60
DATAHUB_VERIFY_SSL=true

# --- Scheduler -------------------------------------------------------------------
# Off in production: Render's free tier spins the service down when idle, so a
# background scanner would run at unpredictable times.
SCHEDULER_ENABLED=false

# --- Database ---------------------------------------------------------------------
# NOT REQUIRED TODAY. No ORM model exists and no endpoint opens a session — the
# engine is constructed lazily and never touched. Do not provision a Render
# Postgres instance for this deploy; it becomes necessary when persisted scan
# history lands (see the roadmap).
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dataguardian


# -----------------------------------------------------------------------------
# FRONTEND — Render Static Site "dataguardian-web"
# -----------------------------------------------------------------------------
#
# Vite INLINES these at BUILD time. Changing one requires a rebuild, not a
# restart — "Clear build cache & deploy" in the Render dashboard.
#
# Only VITE_-prefixed variables reach the browser. Never prefix a secret with
# VITE_: it would be readable in the public JavaScript bundle.

# Backend origin. A bare origin is fine — the client appends /api itself, so
# both of these work:
#   https://dataguardian-api.onrender.com
#   https://dataguardian-api.onrender.com/api
#
# render.yaml wires this automatically via `fromService`, so you normally do
# not set it by hand.
VITE_API_URL=https://dataguardian-api.onrender.com

NODE_VERSION=22
