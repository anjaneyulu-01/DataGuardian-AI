# Backend-local ignores. The root .gitignore already covers these; this file
# keeps the backend self-contained (mirroring frontend/.gitignore) so the rules
# still apply if this folder is ever moved or vendored on its own.

# Virtual environments
.venv/
venv/
env/

# Bytecode and build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets
.env
!.env.example

# Local database files
*.db
*.sqlite3
