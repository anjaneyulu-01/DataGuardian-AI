# Copy to `backend/.env` and fill in. Never commit the real `.env`.

# --- Application -------------------------------------------------------------
PROJECT_NAME=DataGuardian AI
VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- CORS --------------------------------------------------------------------
# JSON array. Must include every browser origin that calls this API.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database ----------------------------------------------------------------
# Use `db` instead of `localhost` as the host when running under Docker Compose.
DATABASE_URL=postgresql+psycopg2://dataguardian:dataguardian@localhost:5432/dataguardian
DB_ECHO=false

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_ENABLED=false
SCAN_INTERVAL_MINUTES=60

# --- DataHub -----------------------------------------------------------------
# Base URL of the GMS service. When going through the DataHub frontend proxy
# (port 9002) use `http://localhost:9002/api/gms` instead.
# NOTE: something unrelated may already be listening on 8080 — check with
#   Get-NetTCPConnection -LocalPort 8080 -State Listen
# before starting the DataHub quickstart, or the two will collide.
DATAHUB_GMS_URL=http://localhost:8080

# Personal access token, created under Settings -> Access Tokens in the
# DataHub UI. Optional against a local quickstart with metadata-service auth
# disabled; required for any secured instance.
DATAHUB_TOKEN=

# GraphQL endpoint path, relative to DATAHUB_GMS_URL.
DATAHUB_GRAPHQL_PATH=/api/graphql

DATAHUB_TIMEOUT_SECONDS=30
# Retries apply to connection failures only, never to an answered request.
DATAHUB_MAX_RETRIES=2
DATAHUB_DEFAULT_PAGE_SIZE=20
DATAHUB_MAX_PAGE_SIZE=200
DATAHUB_VERIFY_SSL=true

# --- LLM ----------------------------------------------------------------------
# Provider selected by LLMFactory. Implemented: grok. Placeholders: gemini,
# openai, claude (selecting one raises a clear "not implemented" error).
LLM_PROVIDER=grok
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2

# --- xAI / Grok -----------------------------------------------------------------
# Create a key at https://console.x.ai. Without it the app still boots; LLM
# calls fail with a configuration error and /health reports unconfigured.
XAI_API_KEY=
XAI_MODEL=grok-4-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# --- Gemini (placeholder provider) ----------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
