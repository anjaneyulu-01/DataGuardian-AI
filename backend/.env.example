# Copy to `backend/.env` and fill in. Never commit the real `.env`.

# --- Application -------------------------------------------------------------
PROJECT_NAME=DataGuardian AI
VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- CORS --------------------------------------------------------------------
# JSON array. Must include every browser origin that calls this API.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database ----------------------------------------------------------------
# Use `db` instead of `localhost` as the host when running under Docker Compose.
DATABASE_URL=postgresql+psycopg2://dataguardian:dataguardian@localhost:5432/dataguardian
DB_ECHO=false

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_ENABLED=false
SCAN_INTERVAL_MINUTES=60

# --- DataHub (not wired up yet) ----------------------------------------------
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# --- Gemini (not wired up yet) -----------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
