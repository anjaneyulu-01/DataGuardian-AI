# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
# `.vscode/*` rather than `.vscode/` — git cannot re-include a file inside an
# excluded directory, so the negations below would be ignored.
.vscode/*
# Shared editor config is committed so the whole team gets the same excludes.
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

